{
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/export_transcript.py\" >/dev/null 2>&1 || true",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/export_transcript.py\" >/dev/null 2>&1 || true",
            "timeout": 30,
            "statusMessage": "Exporting session transcript..."
          }
        ]
      }
    ]
  }
}
