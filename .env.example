# Copy to .env and adjust. Every value below is also the built-in default,
# so the project runs without a .env file.

# --- Database (PostgreSQL + pgvector) ---
POSTGRES_USER=documind
POSTGRES_PASSWORD=documind
POSTGRES_DB=documind
# Host port for local development (`make dev`). Bound to 127.0.0.1 only.
DB_PORT=5433
# Used by the backend when it runs on the host (venv). In Docker this is overridden.
DATABASE_URL=postgresql+psycopg://documind:documind@127.0.0.1:5433/documind

# --- LLM (Ollama, text-to-text only) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:32b
EMBED_MODEL=bge-m3
# Hard limit from the assignment: prompt + completion tokens per call.
LLM_CONTEXT_LIMIT=10000

# --- Web ---
# Address and port of the Dockerised frontend (`make up`).
WEB_BIND=127.0.0.1
WEB_PORT=3000

# --- Storage ---
DATA_DIR=../data
