# DocuMind-AI — environment settings
#
# Copy to .env (`make setup` and `make up` do this when .env is missing). Every value below
# is also the built-in default, so a local run needs no change.
#
# Single source of truth: the only code that reads these is app/backend/app/core/env_loader.py
# (pydantic Settings). It converts each value to its type (bool / int / float / path), fails
# at start-up when a value does not parse, and no other module may call os.getenv — a test
# enforces that. Group and naming conventions:
#   DB_*            the database this service owns
#   HTTP_<MODULE>_* how to reach another module over HTTP: SCHEME, HOST, PORT (protocol
#                   is explicit so an https deployment is a setting, not a code change)
#   LLM_*, TOKEN_*  the model and the token budget (the assignment's hard limit)
#   Everything else is behaviour of this service.
# Values marked [docker] are overridden by docker-compose.yml for the containers.

# ----------------------------------------------------------------------------------------
# Database this service owns (PostgreSQL 16 + pgvector)
# ----------------------------------------------------------------------------------------
DB_HOST=127.0.0.1          # [docker] db
DB_PORT=5433               # [docker] 5432 — the host publishes the container on 5433
DB_NAME=documind
DB_USER=documind
DB_PASSWORD=documind

# ----------------------------------------------------------------------------------------
# Cross-module API: Ollama (text-to-text LLM and the embedding model)
# ----------------------------------------------------------------------------------------
HTTP_OLLAMA_SCHEME=http    # http | https
HTTP_OLLAMA_HOST=127.0.0.1 # [docker] host.docker.internal
HTTP_OLLAMA_PORT=11434

# ----------------------------------------------------------------------------------------
# Models and the token budget
# ----------------------------------------------------------------------------------------
LLM_MODEL=qwen3:32b
EMBED_MODEL=bge-m3
# Hard limit from the assignment: prompt + completion tokens of one call. Every call is
# counted locally before it is sent and recorded afterwards (llm_calls).
LLM_CONTEXT_LIMIT=10000
LLM_THINKING=false
# Added to every local token count before the budget check (ADR 0006).
TOKEN_SAFETY_BUFFER=16
# A question longer than this is refused, never truncated.
QUESTION_TOKEN_BUDGET=200
# The tokenizer the budget guard counts with; must match LLM_MODEL. For qwen3.6 point these at
# third-party/qwen3.6-tokenizer/tokenizer.json and the SHA-256 in that folder's README.
TOKENIZER_PATH=third-party/qwen3-tokenizer/tokenizer.json
TOKENIZER_SHA256=aeb13307a71acd8fe81861d94ad54ab689df773318809eed3cbe794b4492dae4

# ----------------------------------------------------------------------------------------
# Retrieval (values chosen by the P4 experiment, ADR 0010)
# ----------------------------------------------------------------------------------------
CHUNK_SIZE=400
CHUNK_OVERLAP=80
TOP_K=5
# Below this top-1 cosine similarity the question is refused without a model call; also the
# relevance floor of the navigate mode's candidates.
MIN_SIMILARITY=0.50

# ----------------------------------------------------------------------------------------
# Answering modes (experimental; the defaults are the delivered behaviour)
# ----------------------------------------------------------------------------------------
# single | roles | navigate (D71). single = one call, the default.
ANSWER_MODE=single
# navigate mode: temperature of the Navigator call only; 0 = repeatable reading plan, empty =
# the model's default (D77).
NAVIGATION_TEMPERATURE=0
# Temperature of the answer call (single mode, the Analyst, the revision draft). Empty = the
# model's default (qwen3:32b 0.6); 0 = the same evidence gives the same answer (D86).
# Default 0.5 (D89); set 0 for a live demo so that rehearsed answers come back the same.
ANSWER_TEMPERATURE=0.5
# What the program's table-comparison facts do at answer time (D87 experiment A):
# off = checks only; inject = the facts that bear on the question go into the prompt;
# replace = as inject, and a table the facts cover is shown as the compared columns' rows only.
# Default inject (D89): the comparison questions pass only with it (evaluation/facts-ab/).
ANSWER_FACTS=inject
# Ingestion: when a summary's figures contradict its tables, ask the model once to rewrite the
# contradicted sentences with the table's figures as evidence, re-check, and drop what still
# contradicts (D87 experiment B); also triggered by a figure the pages do not hold (D88).
# Off = store the status, keep the text as written. Default on (D89).
SUMMARY_REPAIR=true
# D98: debug mode — append the number, label, claim and arithmetic check notes to answers
# (the checks run and reach the done event either way). Off for the demo.
CHECK_NOTES=false
# Two-call draft-and-revise (D69). Off by default.
ANSWER_REVISION=false
REVISION_SOFT_TRIGGERS=true
REVISION_COMPLETENESS=true
REVISION_ALWAYS=false
# Deterministic correction of comparison words in navigate-mode answers (D75/D76). Off: the
# checks report what they would change, the text is not changed.
AUTO_CORRECTION=false

# ----------------------------------------------------------------------------------------
# Uploads
# ----------------------------------------------------------------------------------------
MAX_UPLOAD_MB=50
DATA_DIR=.data             # [docker] a named volume

# ----------------------------------------------------------------------------------------
# Sessions and request origin
# ----------------------------------------------------------------------------------------
SESSION_TTL_HOURS=168
# Must be true when the site is served over https.
SESSION_COOKIE_SECURE=false
# State-changing requests must come from one of these origins (scheme + host + port). Add the
# address you open the site at if it is not listed, for example http://192.168.1.20:3000.
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173

# ----------------------------------------------------------------------------------------
# Web (Docker deployment): where nginx publishes the site on the host
# ----------------------------------------------------------------------------------------
WEB_BIND=127.0.0.1
WEB_PORT=3000
