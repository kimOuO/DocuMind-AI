# Copy to .env (`make setup` does this for you). Every value is also the built-in
# default, so nothing here has to change for a local run.
# The only code that reads these is app/backend/app/core/env_loader.py.

# --- Database (PostgreSQL + pgvector) ---
# Host and port as seen from the host machine. Inside Docker the backend uses
# db:5432, which docker-compose.yml sets for it.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=documind
DB_USER=documind
DB_PASSWORD=documind

# --- Cross-module API: Ollama (text-to-text LLM and embeddings) ---
# Inside Docker the backend uses host.docker.internal, set in docker-compose.yml.
HTTP_OLLAMA_HOST=127.0.0.1
HTTP_OLLAMA_PORT=11434

# --- LLM ---
LLM_MODEL=qwen3:32b
EMBED_MODEL=bge-m3
# Hard limit from the assignment: prompt + completion tokens of one call.
LLM_CONTEXT_LIMIT=10000
LLM_THINKING=false
# Added to every local token count before the budget check (see ADR 0006).
TOKEN_SAFETY_BUFFER=16
# A question longer than this is refused, never truncated.
QUESTION_TOKEN_BUDGET=200
# Experimental two-call answering (D69): the draft is checked and revised once when the
# checks fault it; nothing is streamed until the final text is chosen. Off by default.
ANSWER_REVISION=false
REVISION_SOFT_TRIGGERS=true
REVISION_COMPLETENESS=true
REVISION_ALWAYS=false

# --- Retrieval ---
CHUNK_SIZE=400
CHUNK_OVERLAP=80
TOP_K=5
MIN_SIMILARITY=0.45

# --- Uploads ---
MAX_UPLOAD_MB=50
DATA_DIR=.data

# --- Sessions and request origin ---
SESSION_TTL_HOURS=168
# Must be true when the site is served over HTTPS.
SESSION_COOKIE_SECURE=false
# State-changing requests must come from one of these origins. Add the address
# you open the site at if it is not listed (for example a LAN IP).
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173

# --- Web (Docker deployment) ---
WEB_BIND=127.0.0.1
WEB_PORT=3000
